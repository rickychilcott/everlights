#!/usr/bin/env ruby
require_relative "../lib/everlights"
require "optparse"

USAGE = <<~TXT
  Usage: everlights COMMAND [args] [options]

  Cloud (bridge firmware B5010 and later turned off local control):
    login EMAIL [--bridge SERIAL]         sign in to your EverLights account; commands then go through the cloud
                                          (asks for the password, or reads it from a pipe; saves tokens, not it)
    logout                                forget the login; commands use the local bridge API again

  Bridge:
    bridge                                firmware, network, cloud, zone health
    bridge health                         ok/WARN per check; exit 2 on any warning (for cron)
    bridge time [TIME]                    set the bridge clock (default now)
    bridge reboot --yes                   restart the bridge
    zones                                 raw zone data (JSON)

  Now (a running show takes back over at its next sequence change):
    show                                  what each zone is playing
    set COLOR... [--effect E[=N]]         show colors now
    play SEQUENCE                         show a saved sequence now
    off                                   lights dark
    clear                                 hand control back to the calendar

  Sequences:
    sequence list [FILTER]
    sequence add NAME COLOR... [--effect E[=N]]...
    sequence update NAME COLOR... [--effect E[=N]]...   replace colors and effects
    sequence remove NAME

  Calendar:
    calendar list [--limit DAYS]          upcoming shows, default next 365 days
    calendar add DATE NAME SEQ[:SECS],... [--start HH:MM] [--end HH:MM] [--until DATE]
                                          default dusk to 23:00, 20s per sequence
    calendar remove DATE NAME

  Sync (config/everlights.yml: sequences + schedule):
    init [--host HOST]                    write a starter config: holidays, a birthday, a season
    sync [--dry-run] [--adopt]            build sequences and the calendar ahead; prints the plan
    sync --check                          plan only; exit 2 if the bridge needs a sync (for cron)
    web [--port N]                        edit the config in a browser and apply it (localhost:4567)
    export                                what the app made (sequences, shows) as config YAML, for sync --adopt

  Options:
TXT

opts = {effects: {}, limit: 365}
parser = OptionParser.new do |o|
  o.banner = USAGE
  o.on("--host HOST", "bridge IP, for the local API (default when not logged in: $EVERLIGHTS_HOST, then the config's bridge.host)") { opts[:host] = _1 }
  o.on("--bridge SERIAL", "login: which of the account's bridges to use (default the first)") { opts[:bridge] = _1 }
  o.on("--config PATH", "config file (default $EVERLIGHTS_CONFIG, then config/everlights.yml)") { opts[:config] = _1 }
  o.on("--zone SERIAL", "limit set/play/off/clear/show to a zone (repeatable)") { (opts[:zones] ||= []) << _1 }
  o.on("--effect E[=N]", "N 0-255 (default 128): #{Everlights::EFFECTS.join(" ")}") do |e|
    type, value = e.split("=")
    opts[:effects][type] = value
  end
  o.on("--limit DAYS", Integer, "calendar list horizon") { opts[:limit] = _1 }
  o.on("--start HH:MM", "fixed start instead of dusk") { opts[:start] = _1 }
  o.on("--end HH:MM", "default 23:00; earlier than start = next morning") { opts[:end] = _1 }
  o.on("--until DATE", "repeat nightly through DATE") { opts[:until] = _1 }
  o.on("--json", "JSON output for lists, show and bridge") { opts[:json] = true }
  o.on("--yes", "confirm bridge reboot") { opts[:yes] = true }
  o.on("--dry-run", "sync: print the plan only") { opts[:dry_run] = true }
  o.on("--check", "sync: plan only, exit 2 if anything would change") { opts[:check] = true }
  o.on("--port N", Integer, "web: port (default 4567)") { opts[:port] = _1 }
  o.on("--adopt", "sync: take over bridge items whose names match the config") { opts[:adopt] = true }
end
parser.parse!
abort parser.help if ARGV.empty?

def json(obj) = puts(JSON.pretty_generate(obj))

begin
  config_path = opts[:config] || ENV["EVERLIGHTS_CONFIG"] || "config/everlights.yml"
  config = if File.exist?(config_path) then Everlights::Sync.load_config(config_path)
           elsif (opts[:config] || ENV["EVERLIGHTS_CONFIG"]) && ARGV.first != "init" then raise Everlights::Error, "no config at #{config_path}"
           end
  ENV["TZ"] = config["timezone"] if config&.dig("timezone")
  cmd = ARGV.shift
  cmd = "#{cmd} #{ARGV.shift}" if %w[sequence calendar].include?(cmd) ||
                                   (cmd == "bridge" && %w[health time reboot].include?(ARGV.first))
  arg = ARGV.join(" ")
  cloud = Everlights::Cloud.new

  case cmd
  when "login"
    abort "login EMAIL" unless ARGV.size == 1
    password = if $stdin.tty?
                 require "io/console"
                 IO.console.getpass("EverLights password for #{arg}: ")
               else $stdin.gets.to_s.chomp
               end
    cloud, bridges = Everlights::Cloud.login(arg, password, bridge: opts[:bridge])
    bridges.each { |b| puts "#{b["serial"] == cloud.bridge ? "*" : " "} #{b["serial"]}  #{b["name"]}  firmware #{b["firmware"]}" }
    puts "Logged in. Commands now go to bridge #{cloud.bridge} through the EverLights cloud."
    puts "To use another, run `everlights login #{arg} --bridge SERIAL`." if bridges.size > 1
    exit
  when "logout"
    cloud.logout
    puts "Logged out. Commands use the local bridge API again."
    exit
  when "init"
    raise Everlights::Error, "#{config_path} already exists; edit it, or pass --config to start another" if File.exist?(config_path)
    text = File.read(File.expand_path("../config/everlights.example.yml", __dir__))
    text = opts[:host] ? text.sub("192.168.1.50", opts[:host]) : text.sub(/^bridge:.*\n  host:.*\n/) { _1.gsub(/^/, "# ") }
    text = text.sub(/^location:.*\n(?:  .*\n)+/) { _1.gsub(/^/, "# ") } # no default: a wrong one means wrong dusk times
    tz = File.symlink?("/etc/localtime") && File.readlink("/etc/localtime")[%r{zoneinfo/(.+)\z}, 1]
    text = text.sub(/^# timezone: \S+/) { "timezone: #{tz}" } if tz
    FileUtils.mkdir_p(File.dirname(config_path))
    File.write(config_path, text)
    puts "Wrote #{config_path}. Next:"
    puts "  - Uncomment `location:` and put in your latitude and longitude; dusk is worked out from them."
    puts "  - Run `everlights login EMAIL`, or set bridge.host for the local API (firmware before B5010)." unless cloud.logged_in? || opts[:host]
    puts "  - Edit the sequences and schedule, then run `everlights sync --dry-run`."
    exit
  end

  # Logged in: through the cloud, unless --host asks for the local API.
  el = if cloud.logged_in? && !opts[:host] then Everlights::Client.new(cloud: cloud)
       else Everlights::Client.new(opts[:host] || ENV["EVERLIGHTS_HOST"] || config&.dig("bridge", "host"))
       end
  zones = opts[:zones]

  case cmd
  when "bridge"
    b = el.status
    if opts[:json] then json(b)
    else
      at = ->(v) { v ? Time.parse(v).localtime.strftime("%Y-%m-%d %H:%M:%S") : "?" }
      net = b["network"] || {}
      puts "Bridge #{b["serial"]}  firmware #{b["firmwareVersion"]}, radio #{b["radioFirmwareVersion"] || "?"}#{"  (via the EverLights cloud)" if el.cloud?}"
      puts "  network  #{net["interface"] || "?"} #{b["localIp"]}, ntp #{{true => "ok", false => "off"}.fetch(net["ntp"], "?")}"
      puts "  cloud    #{b["serverReachable"] ? "reachable" : "UNREACHABLE"}, last check-in #{at.(b["lastServerCheckin"])}"
      puts "  reboots  #{b["rebootCount"]}"
      b["zones"].each do |z|
        puts "Zone #{z["serial"]}  firmware #{z["firmwareVersion"]}, #{z["configuredLength"]} pixels #{z["colorOrder"]}, #{z["active"] ? "active" : "INACTIVE"}"
        puts "  signal   rssi #{z["rssi"]}, snr #{z["snr"]}"
        puts "  sensors  temperature #{z["temperature"]}, voltage #{z["voltage"]}, current #{z["current"]} (raw, units unknown)"
        puts "  last     request #{at.(z["lastRequestDate"])}, response #{at.(z["lastResponseDate"])}, reboots #{z["rebootCount"]}"
      end
    end
  when "bridge health"
    checks = Everlights.health(el.status, via_cloud: el.cloud?)
    checks.each { |ok, name, text| puts "#{{info: "info", true => "ok  ", false => "WARN"}[ok]}  #{name.ljust(19)} #{text}" }
    exit 2 unless checks.all? { _1[0] }
  when "bridge time"
    time = ARGV.empty? ? Time.now : Time.parse(arg)
    el.set_time(time)
    puts "bridge clock set to #{time}"
  when "bridge reboot"
    abort "rebooting interrupts the lights; rerun with --yes" unless opts[:yes]
    el.reboot
    puts "rebooting bridge"
  when "zones" then json el.zones
  when "show"
    playing = el.now_playing(zones: zones)
    if opts[:json] then json(playing)
    else
      playing.each do |zone, p|
        what = if p[:off] then "off"
               elsif p[:name] then "#{p[:name]}#{" (#{p[:show]} show)" if p[:show]}"
               else "custom colors #{p[:pattern].join(" ")}"
               end
        fx = p[:effects].map { "#{_1["effectType"]}=#{_1["value"]}" }.join(" ")
        puts "#{zone}  #{what}#{"  #{fx}" unless fx.empty?}"
      end
    end
  when "set"
    abort "set needs colors" if ARGV.empty?
    el.set(*ARGV, effects: opts[:effects], zones: zones)
    puts "showing #{arg}"
  when "play" then puts "playing #{el.play(arg, zones: zones)["alias"]}"
  when "off"
    el.off(zones: zones)
    puts "off"
  when "clear"
    el.clear(zones: zones)
    puts "cleared, calendar in control"

  when "sequence list"
    seqs = el.sequences.list(arg)
    if opts[:json] then json(seqs)
    else
      seqs.each do |s|
        mark = s["id"].start_with?(Everlights::BUILTIN_PREFIX) ? " " : "*"
        fx = s["effects"].map { "#{_1["effectType"]}=#{_1["value"]}" }.join(" ")
        puts "#{mark} #{s["alias"].ljust(28)} #{s["pattern"].size.to_s.rjust(3)} color#{"s" unless s["pattern"].size == 1}#{" " if s["pattern"].size == 1}  #{fx}"
      end
    end
  when "sequence add"
    name, *colors = ARGV
    abort "sequence add NAME COLOR..." if colors.empty?
    el.sequences.add(name, *colors, effects: opts[:effects])
    puts "added sequence #{name}"
  when "sequence update"
    name, *colors = ARGV
    abort "sequence update NAME COLOR..." if colors.empty?
    el.sequences.update(name, *colors, effects: opts[:effects])
    puts "updated sequence #{name}"
  when "sequence remove"
    el.sequences.remove(arg)
    puts "removed sequence #{arg}"

  when "calendar list"
    shows = el.calendar.list(limit: opts[:limit])
    if opts[:json]
      json(shows.map { |s| s.merge(date: s[:date].iso8601, start: s[:start].iso8601, finish: s[:finish].iso8601) })
    elsif shows.empty?
      puts "nothing scheduled in the next #{opts[:limit]} days"
    else
      shows.each do |s|
        window = "#{s[:dusk] ? "dusk" : s[:start].strftime("%H:%M")}-#{s[:finish].strftime("%H:%M")}"
        seqs = s[:sequences].map { |n, secs| "#{n}:#{secs}" }.join(", ")
        puts "#{s[:start].strftime("%a %Y-%m-%d")}  #{window.ljust(11)}  #{s[:name]}  (#{seqs})"
      end
    end
  when "calendar add"
    date, name, *rest = ARGV
    abort "calendar add DATE NAME SEQ[:SECS],..." if rest.empty?
    el.calendar.add(date, name, rest.join(" "), start: opts[:start], finish: opts[:end] || "23:00", through: opts[:until])
    puts "added #{name} on #{date}#{" through #{opts[:until]}" if opts[:until]}"
  when "calendar remove"
    date, *name = ARGV
    abort "calendar remove DATE NAME" if name.empty?
    el.calendar.remove(date, name.join(" "))
    puts "removed #{name.join(" ")} on #{date}"

  when "sync"
    raise Everlights::Error, "no config at #{config_path}; run `everlights init` to start one" unless config
    plan = Everlights::Sync.new(el, config, state_path: Everlights::Sync.state_path(config_path), adopt: opts[:adopt]).plan
    puts plan
    if plan.empty? then nil
    elsif opts[:check] then exit 2
    elsif opts[:dry_run] then puts "\n(dry run: nothing applied)"
    else
      plan.apply!
      puts "\nApplied."
    end

  when "export"
    require_relative "../lib/everlights/web"
    found, notes = Everlights::Sync.export(el, state_path: Everlights::Sync.state_path(config_path))
    found.reject! { _2.empty? }
    puts "# Made outside sync: in the EverLights app, or with `sequence add` / `calendar add`."
    if found.empty? then puts "# Nothing. Everything on the bridge is built in or made by sync."
    else
      puts "# To manage these from your config, add them to it, then run `everlights sync --adopt --dry-run`."
    end
    notes.each { puts "# Left out: #{_1}" }
    puts Everlights::Web.dump(found) unless found.empty?

  when "web"
    raise Everlights::Error, "no config at #{config_path}; run `everlights init` to start one" unless config
    require_relative "../lib/everlights/web"
    Everlights::Web.new(el, config_path, port: opts[:port] || 4567).start

  else abort parser.help
  end
rescue Everlights::Error, IndexError, ArgumentError, TypeError, Date::Error, SystemCallError, Net::OpenTimeout => e
  abort "error: #{e.message}"
end
